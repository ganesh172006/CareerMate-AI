# Gemini mode: add your own API key below.
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180

# Optional local transcription setting (not used in Gemini voice mode).
WHISPER_MODEL_SIZE=tiny

# Optional providers; not used unless their provider is configured in code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# OpenAI is intentionally not called by the local-first workflow.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
